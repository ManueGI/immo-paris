# API server
API_HOST=127.0.0.1
API_PORT=8000

# PostgreSQL database
DATABASE_URL=postgresql://immo:change-me@localhost:5432/immo_paris
# Used by compose.yaml to create the database container (must match DATABASE_URL)
POSTGRES_USER=immo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=immo_paris

# DVF data
DVF_BASE_URL=https://files.data.gouv.fr/geo-dvf/latest/csv
DVF_DEPARTEMENT=75
DATA_DIR=data
SAMPLE_CSV=data/dvf_paris_sample.csv

# Allowed front-end origins (comma-separated)
CORS_ORIGINS=http://localhost:4200,http://localhost:8081
