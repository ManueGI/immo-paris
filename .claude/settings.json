{
  "permissions": {
    "allow": [
      "Bash(uv run --directory api pytest *)",
      "Bash(uv run --directory api ruff *)",
      "Bash(uv run --directory api alembic check)",
      "Bash(uv run --directory api alembic current)",
      "Bash(uv run --directory api alembic history *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_python.py\""
          }
        ]
      }
    ]
  }
}
